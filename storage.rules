rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (userDoc().data.role != null
          ? userDoc().data.role
          : (userDoc().data.roles != null && userDoc().data.roles.size() > 0
            ? userDoc().data.roles[0]
            : null));
    }

    function hasRole(role) {
      return isSignedIn() && userRole() == role;
    }

    function hasAnyRole(roles) {
      return isSignedIn() && userRole() in roles;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /expenses/{allPaths=**} {
      allow read, write: if hasAnyRole(['admin', 'accountant', 'admission_manager', 'super_admin']);
      allow delete: if hasAnyRole(['admin', 'super_admin']);
    }

    match /inquiries/{allPaths=**} {
      allow read, write: if hasAnyRole(['admin', 'admission_manager', 'super_admin']);
      allow delete: if hasAnyRole(['admin', 'super_admin']);
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
